# Copy to ignored .env. Full reference: docs/SETUP.md.
# Local development defaults; use HTTPS and real private credentials in production.
APP_NAME="7B AHMED TAMER"
APP_ENV=local
# Generate with php artisan key:generate; retain the key for this environment.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
# Use your PostgreSQL port: commonly 5432; the optional setup helper defaults to 5433.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=orbit_crm
DB_USERNAME=orbit_crm_app
# Enter the password of your restricted application role. Never commit .env.
DB_PASSWORD=
DB_SSLMODE=prefer
# Session payload encryption and HttpOnly are enforced by application code.
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ABSOLUTE_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
# false is for local HTTP only; production code forces secure cookies.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Host:port without a scheme; FRONTEND_URL above is the exact allowed CORS origin.
SANCTUM_STATEFUL_DOMAINS=localhost:5173
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log
# Choose openai or gemini. Only the selected provider needs a key.
# Model identifiers below match repository defaults; your account must support them.
AI_PROVIDER=openai
# Private backend-only keys. Leave empty to explore the core CRM without AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional absolute path to a trusted PEM bundle; never disable TLS verification.
AI_CA_BUNDLE=
